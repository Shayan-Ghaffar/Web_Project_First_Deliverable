@model IEnumerable<KhoyaPaya.Models.ItemModel>

@{
    ViewData["Title"] = "Home - Khoya Paya";
}

<style>
    .item-img {
        height: 180px;
        object-fit: cover;
    }
</style>

<div class="container my-4">
    <div class="row g-2 mb-4">
        <div class="col-md-8">
            <input type="text" class="form-control shadow-sm" placeholder="Search lost items..." style="background: rgba(255, 255, 255, 0.85); border: 1px solid rgba(255, 255, 255, 0.6);">
        </div>
        <div class="col-md-4">
            <select class="form-select shadow-sm" style="background: rgba(255, 255, 255, 0.85); border: 1px solid rgba(255, 255, 255, 0.6);">
                <option selected>All Items</option>
                <option value="LOST">Lost Items Only</option>
                <option value="FOUND">Found Items Only</option>
            </select>
        </div>
    </div>

    <h3 class="comic-heading fw-bold mb-3 text-dark">Recent Items</h3>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 rounded-4 shadow-sm" style="background: rgba(255, 255, 255, 0.80); border: 1px solid rgba(255, 255, 255, 0.6);">
                        <img src="@item.ImagePath" class="card-img-top rounded-top-4 item-img" alt="@item.Title">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge @(item.Category == "LOST" ? "bg-danger" : "bg-success") fw-bold">@item.Category</span>
                                <small class="text-muted fw-bold">@item.CreatedAt.ToString("g")</small>
                            </div>
                            <h5 class="card-title comic-heading fw-bold text-dark">@item.Title</h5>
                            <p class="card-text text-dark small fw-bold flex-grow-1">@item.Description</p>
                            <div class="p-2 rounded bg-light mb-2 border small text-muted fw-bold">
                                Posted by: <span class="text-dark">@item.PostedBy</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted fw-bold fs-5">No items posted yet. Be the first to post a lost or found item!</p>
            </div>
        }
    </div>
</div>
<div class="modal fade" id="postModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 shadow" style="background: rgba(255, 255, 255, 0.95); border: 1px solid rgba(255, 255, 255, 0.8);">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title comic-heading fs-4 fw-bold text-dark">Post Lost / Found Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-2">
                <form asp-controller="Home" asp-action="PostItem" method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark">Item Title</label>
                        <input type="text" name="title" class="form-control shadow-sm" placeholder="e.g. Black Backpack" required style="background: rgba(255, 255, 255, 0.9);">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark">Category</label>
                        <select name="category" class="form-select shadow-sm" style="background: rgba(255, 255, 255, 0.9);">
                            <option value="LOST">Lost</option>
                            <option value="FOUND">Found</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark">Description</label>
                        <textarea name="description" class="form-control shadow-sm" rows="3" placeholder="Provide details..." required style="background: rgba(255, 255, 255, 0.9);"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark">Upload Image from Device</label>
                        <input type="file" name="imageFile" class="form-control shadow-sm" accept="image/*" required style="background: rgba(255, 255, 255, 0.9);">
                    </div>
                    <button type="submit" class="btn btn-primary w-100 fw-bold shadow-sm py-2">Publish Post</button>
                </form>
            </div>
        </div>
    </div>
</div>